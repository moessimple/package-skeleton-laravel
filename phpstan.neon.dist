includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    paths:
        - config/
        - database/
        - routes/
        - src/
        - tests/
        - workbench/

    level: max

    reportUnmatchedIgnoredErrors: true

    tmpDir: build/phpstan
